# Environment variables for Instagram Quote Poster
# Copy this to .env and fill in your actual values

# Optional overrides (these have defaults in the code)
BRAND=success.for.sure™
CATEGORIES=business,entrepreneurship,leadership,success,motivation
HASHTAGS=#motivatemedaily,#inspire,#inspiremedaily,#motivate,#hustle,#hardwork
LOCATIONS=#gurgaon,#delhidiaries
SLOT_ID=1

# REQUIRED: Get your Unsplash access key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# You can also get a Secret Key if you need to make authenticated requests
# UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here
