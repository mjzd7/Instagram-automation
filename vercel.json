{
  "version": 2,
  "builds": [
    {
      "src": "api/generate.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*", "dist/**/*", "scripts/**/*", "treatment-state.json", "package.json"]
      }
    },
    {
      "src": "api/post.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*", "dist/**/*", "scripts/**/*", "package.json"]
      }
    },
    {
      "src": "api/test.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*", "dist/**/*", "scripts/**/*", "package.json"]
      }
    },
    {
      "src": "api/health.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/generate",
      "dest": "/api/generate.ts"
    },
    {
      "src": "/api/post",
      "dest": "/api/post.ts"
    },
    {
      "src": "/api/test",
      "dest": "/api/test.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    }
  ]
}
